{
  "specVersion": 1,
  "kind": "tool",
  "id": "hlk-viewer",
  "name": "HLK Viewer",
  "version": "1.2.7",
  "description": "Windows HLK 結果檢視：.hlkx test config 與 Te.wtl / HTA log 解析、彙總報表匯出 HTML（GUI + Web）",
  "runtime": { "kind": "powershell", "min": "5.1" },
  "web": { "entry": "HLK-Web.ps1", "defaultPort": 8780, "health": "/api/health" },
  "cli": { "entry": "Launch-HLK.ps1", "menu": false, "json": false },
  "requires": ["python"],
  "dataDir": "%LOCALAPPDATA%/DevToolbox/hlk-viewer",
  "uiKit": "3.2.0"
}
